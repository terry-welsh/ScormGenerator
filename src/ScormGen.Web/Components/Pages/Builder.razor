@page "/builder"
@namespace ScormGen.Web.Components.Pages
@using Microsoft.Extensions.Caching.Memory
@using System.Text.Json.Nodes
@using ScormGen.Core
@using ScormGen.Web.Components.Pages.BuilderComponents
@inject IMemoryCache DownloadCache
@inject IJSRuntime JS

<PageTitle>SCORM Generator — Course Builder</PageTitle>

<div class="max-w-3xl mx-auto">
    <h1 class="text-2xl font-bold mb-2">Course Builder</h1>
    <p class="text-gray-500 mb-6 text-sm">Build a course definition interactively and generate SCORM 2004 packages.</p>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6 mb-6">
        <h2 class="text-base font-semibold mb-4 text-gray-800">Course Details</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Course ID</label>
                <input @bind="_courseId" placeholder="COURSE_001" class="@BuilderStyles.Input" />
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-600 mb-1">Version</label>
                <input @bind="_version" placeholder="1.0" class="@BuilderStyles.Input" />
            </div>
            <div class="sm:col-span-2">
                <label class="block text-xs font-medium text-gray-600 mb-1">Course Title</label>
                <input @bind="_courseTitle" placeholder="e.g. Introduction to Safety" class="@BuilderStyles.Input" />
            </div>
        </div>
    </div>

    @for (int pi = 0; pi < _packages.Count; pi++)
    {
        var pkgIdx = pi;
        <PackageCard Package="_packages[pi]" Index="@pi"
                     OnRemove="@(() => RemovePackage(pkgIdx))"
                     OnAddContent="@((item) => AddContent(pkgIdx, item))"
                     OnRemoveContent="@((ci) => RemoveContent(pkgIdx, ci))" />
    }

    <button @onclick="AddPackage"
            class="w-full py-3 border-2 border-dashed border-gray-300 rounded-xl text-sm text-gray-400 hover:border-primary hover:text-primary transition-colors mb-6">
        + Add Package
    </button>

    @if (_error is not null)
    {
        <div class="mb-4 p-3 bg-danger/10 border border-danger/20 rounded-lg text-sm text-danger">@_error</div>
    }

    <div class="flex gap-3 mb-8">
        <button @onclick="Generate" disabled="@(_generating || _packages.Count == 0)"
                class="flex-1 py-2 px-4 rounded-lg font-semibold text-white bg-primary hover:bg-success disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
            @(_generating ? "Generating…" : "Generate SCORM Package")
        </button>
        <button @onclick="ExportJson" disabled="@(_packages.Count == 0)"
                class="py-2 px-4 rounded-lg font-semibold text-gray-700 bg-gray-100 hover:bg-gray-200 disabled:opacity-50 transition-colors text-sm">
            Export JSON
        </button>
    </div>

    @if (_downloadReady)
    {
        <div class="p-3 bg-success/10 border border-success/20 rounded-lg text-sm text-success font-medium">
            Package ready — download started automatically.
        </div>
    }
</div>

@code {
    private string _courseId = "";
    private string _courseTitle = "";
    private string _version = "1.0";
    private readonly List<BPackage> _packages = new();
    private bool _generating;
    private bool _downloadReady;
    private string? _error;

    private void AddPackage() => _packages.Add(new BPackage());
    private void RemovePackage(int i) => _packages.RemoveAt(i);
    private void AddContent(int pkgIdx, BContentItem item) => _packages[pkgIdx].Content.Add(item);
    private void RemoveContent(int pkgIdx, int cIdx) => _packages[pkgIdx].Content.RemoveAt(cIdx);

    private async Task Generate()
    {
        _generating = true;
        _downloadReady = false;
        _error = null;
        try
        {
            var json = BuildJson();
            var course = ScormGen.Core.Loading.CourseLoader.Load(json);
            var zipBytes = ScormGen.Core.Packaging.ScormPackager.PackageCourse(course);
            var id = Guid.NewGuid().ToString("N");
            DownloadCache.Set($"dl_{id}", zipBytes, TimeSpan.FromMinutes(5));
            await JS.InvokeVoidAsync("scormGen.triggerDownload", $"/download/{id}");
            _downloadReady = true;
        }
        catch (ArgumentException ex) { _error = ex.Message; }
        catch (Exception ex) { _error = $"Generation failed: {ex.Message}"; }
        finally { _generating = false; }
    }

    private async Task ExportJson()
    {
        _error = null;
        try
        {
            var json = BuildJson();
            var filename = string.IsNullOrWhiteSpace(_courseId) ? "course.json" : $"{_courseId.ToLowerInvariant()}.json";
            await JS.InvokeVoidAsync("scormGen.downloadText", json, filename, "application/json");
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private string BuildJson()
    {
        var pkgsArray = new JsonArray();
        for (int i = 0; i < _packages.Count; i++)
        {
            var p = _packages[i];
            var contentArray = new JsonArray();
            foreach (var item in p.Content)
                contentArray.Add(SerializeItem(item));

            var pkg = new JsonObject
            {
                [JsonKeys.FileNumber]  = i + 1,
                [JsonKeys.FileName]    = p.FileName,
                [JsonKeys.ContentType] = p.ContentType,
                [JsonKeys.Title]       = p.Title,
                [JsonKeys.Content]     = contentArray
            };
            if (p.ContentType == "graded")
                pkg[JsonKeys.PassingScore] = p.PassingScore;
            pkgsArray.Add(pkg);
        }

        return new JsonObject
        {
            [JsonKeys.CourseId] = _courseId,
            [JsonKeys.Title]    = _courseTitle,
            [JsonKeys.Version]  = _version,
            [JsonKeys.Packages] = pkgsArray
        }.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    }

    private static JsonNode SerializeItem(BContentItem item) => item switch
    {
        BHeading h       => new JsonObject { [JsonKeys.Type] = JsonKeys.TypeHeading, [JsonKeys.Level] = h.Level, [JsonKeys.Text] = h.Text },
        BParagraph p     => new JsonObject { [JsonKeys.Type] = JsonKeys.TypeParagraph, [JsonKeys.Text] = p.Text },
        BBulletedList bl => new JsonObject
        {
            [JsonKeys.Type]  = JsonKeys.TypeBulletedList,
            [JsonKeys.Items] = new JsonArray(bl.Items.Select(s => (JsonNode)JsonValue.Create(s)!).ToArray())
        },
        BMultipleChoice mc => new JsonObject
        {
            [JsonKeys.Type]          = JsonKeys.TypeMultipleChoice,
            [JsonKeys.Question]      = mc.Question,
            [JsonKeys.Options]       = new JsonArray(mc.Options.Select((o, idx) => (JsonNode)new JsonObject
            {
                [JsonKeys.Letter] = ((char)('A' + idx)).ToString(),
                [JsonKeys.Text]   = o.Text
            }).ToArray()),
            [JsonKeys.CorrectAnswer] = mc.CorrectAnswer,
            [JsonKeys.Explanation]   = mc.Explanation
        },
        BScenario sc => new JsonObject
        {
            [JsonKeys.Type]          = JsonKeys.TypeScenario,
            [JsonKeys.Name]          = sc.Name,
            [JsonKeys.Situation]     = sc.Situation,
            [JsonKeys.Options]       = new JsonArray(sc.Options.Select((o, idx) => (JsonNode)new JsonObject
            {
                [JsonKeys.Letter]   = ((char)('A' + idx)).ToString(),
                [JsonKeys.Text]     = o.Text,
                [JsonKeys.Analysis] = o.Analysis
            }).ToArray()),
            [JsonKeys.CorrectOption] = sc.CorrectOption,
            [JsonKeys.KeyInsight]    = sc.KeyInsight
        },
        _ => throw new InvalidOperationException($"Unknown type: {item.GetType().Name}")
    };
}
