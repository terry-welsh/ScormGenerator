@page "/"
@using Microsoft.Extensions.Caching.Memory
@inject IJSRuntime JS
@inject ScormGen.Core.Loading.CourseLoader Loader
@inject ScormGen.Core.Packaging.ScormPackager Packager
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache DownloadCache

<PageTitle>SCORM Generator — Upload</PageTitle>

<div class="max-w-xl mx-auto">
    <h1 class="text-2xl font-bold mb-2">Generate SCORM Package</h1>
    <p class="text-gray-500 mb-6 text-sm">Upload a course JSON file to generate a SCORM 2004 3rd Edition ZIP package.</p>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-6">
        <label class="block text-sm font-medium text-gray-700 mb-2">Course JSON file</label>
        <InputFile OnChange="HandleFileSelected" accept=".json"
                   class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-primary/10 file:text-primary hover:file:bg-primary/20 cursor-pointer" />

        @if (_error is not null)
        {
            <p class="mt-3 text-sm text-danger">@_error</p>
        }

        <button @onclick="Generate"
                disabled="@(_file is null || _generating)"
                class="mt-4 w-full py-2 px-4 rounded-lg font-semibold text-white bg-primary hover:bg-success disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
            @(_generating ? "Generating…" : "Generate SCORM Package")
        </button>

        @if (_generating)
        {
            <div class="mt-3 h-2 bg-gray-100 rounded-full overflow-hidden">
                <div class="h-full bg-primary animate-pulse w-full"></div>
            </div>
        }

        @if (_downloadReady)
        {
            <div class="mt-4 p-3 bg-success/10 border border-success/20 rounded-lg text-sm text-success font-medium">
                Package ready — download started automatically.
            </div>
        }
    </div>
</div>

@code {
    private IBrowserFile? _file;
    private bool _generating;
    private bool _downloadReady;
    private string? _error;

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _file = e.File;
        _downloadReady = false;
        _error = null;
    }

    private async Task Generate()
    {
        if (_file is null) return;

        _generating = true;
        _downloadReady = false;
        _error = null;

        try
        {
            using var stream = _file.OpenReadStream(maxAllowedSize: 16 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var json = System.Text.Encoding.UTF8.GetString(ms.ToArray());

            var course = Loader.Load(json);
            var zipBytes = Packager.PackageCourse(course);

            var id = Guid.NewGuid().ToString("N");
            DownloadCache.Set($"dl_{id}", zipBytes, TimeSpan.FromMinutes(5));

            await JS.InvokeVoidAsync("scormGen.triggerDownload", $"/download/{id}");
            _downloadReady = true;
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = $"Generation failed: {ex.Message}";
        }
        finally
        {
            _generating = false;
        }
    }
}
