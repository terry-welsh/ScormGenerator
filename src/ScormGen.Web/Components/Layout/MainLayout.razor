@inherits LayoutComponentBase

<div class="min-h-screen flex flex-col">
    <header class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-4xl mx-auto px-4 py-3 flex items-center gap-3">
            <span class="text-2xl font-bold text-primary">SCORM</span>
            <span class="text-2xl font-semibold text-gray-700">Generator</span>
            <nav class="ml-auto flex gap-4 text-sm">
                <NavLink class="text-gray-600 hover:text-primary transition-colors" href="" Match="NavLinkMatch.All">Upload</NavLink>
                <NavLink class="text-gray-600 hover:text-primary transition-colors" href="builder">Builder</NavLink>
                <NavLink class="text-gray-600 hover:text-primary transition-colors" href="content-prep">Content Prep</NavLink>
            </nav>
        </div>
    </header>

    <main class="flex-1 max-w-4xl mx-auto w-full px-4 py-8">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet
     class="hidden fixed bottom-4 right-4 bg-danger text-white px-4 py-2 rounded shadow-lg">
    An unhandled error has occurred.
    <a href="." class="underline ml-2">Reload</a>
</div>
